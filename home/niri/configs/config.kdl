prefer-no-csd
spawn-at-startup "noctalia"
//include "startup.kdl"
include "layout.kdl"
include "input.kdl"
include "rules.kdl"
include "binds.kdl"
include "events.kdl"

environment {
  QT_QPA_PLATFORMTHEME "qt6ct"
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include optional=true "noctalia.kdl"

